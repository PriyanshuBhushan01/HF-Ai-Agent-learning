# ==========================================
# Python cache and compiled files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Virtual environments
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Secrets and API tokens — NEVER upload
# ==========================================
.env
.env.*
!.env.example
*.key
*.pem
*.secret
*.credentials

# ==========================================
# IDE / editor files
# ==========================================
.vscode/
.idea/

# ==========================================
# Operating system files
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Python tooling caches
# ==========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# Build and package files
# ==========================================
build/
dist/
*.egg-info/

# ==========================================
# Jupyter Notebook temporary files
# ==========================================
.ipynb_checkpoints/

# ==========================================
# Local AI data, models, outputs, and logs
# ==========================================
data/
datasets/
raw_data/
models/
checkpoints/
outputs/
cache/
logs/
*.log

# ==========================================
# Large model and ML artifact files
# ==========================================
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.h5
*.hdf5
*.keras
*.pkl
*.pickle
*.joblib

# ==========================================
# Downloaded or compressed data files
# ==========================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z
